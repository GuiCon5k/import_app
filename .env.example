# Opcional: solamente para análisis asistido por IA. No compartir ni subir a Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MAX_AI_REQUESTS_PER_DAY=5
# Puerto local. El servidor escucha solo en tu PC por seguridad.
PORT=3000

# BLOQUEO PRINCIPAL: las funciones de pago NO se ejecutan hasta cambiarlo a true.
PAID_API_ENABLED=false

# Investigador automático: requiere API con búsqueda web. Puede generar cargos extra.
RESEARCH_MODEL=gpt-5-mini
MAX_RESEARCH_RUNS_PER_DAY=2
AUTO_RESEARCH_ENABLED=false
RESEARCH_INTERVAL_DAYS=7

# OPCIONAL: token OAuth de Mercado Libre para validar publicaciones por /items/bulk.
# Sin este token se muestran enlaces de publicaciones, sin atribuir precios confirmados.
ML_ACCESS_TOKEN=

# Solo para publicar en Render; configurarlas allí (no en GitHub).
# NODE_ENV=production activa protección con usuario y contraseña.
NODE_ENV=production
APP_USERNAME=
APP_PASSWORD=

# Mercado Libre OAuth. Cargar en Render > Environment (no subir claves al repositorio).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://import-app-guicon.onrender.com/auth/mercadolibre/callback

# Upstash Redis REST: almacenamiento persistente y cifrado de tokens OAuth.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generar localmente con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ML_TOKEN_ENCRYPTION_KEY=

# Activar solamente si PKCE está habilitado en tu app de Mercado Libre.
ML_PKCE_ENABLED=false
